# Database and authentication
MONGODB_URI=mongodb://localhost:27017/smartcart
JWT_SECRET_KEY=replace-with-a-long-random-value

# Email-based two-factor authentication
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password

# Recipe and grocery integrations
API_KEY=your-spoonacular-api-key
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret

# Personalized recommendations
OPENAI_API_KEY=your-openai-api-key
RECOMMENDATION_EMBEDDING_MODEL=text-embedding-ada-002
